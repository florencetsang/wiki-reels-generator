# Google / Gemini
GEMINI_API_KEY=replace_me
# "gemini-2.5-flash-image" is Nano Banana-compatible.
# Change this if your Gemini account exposes a different image model.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Cloudflare R2 S3 credentials
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=wikipedia-reels

# Optional: only needed when using a jurisdiction-specific R2 endpoint.
# R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Cloudflare D1 progress database. Leave unset to use local SQLite.
# The API token needs D1 Edit permission. Account ID defaults to R2_ACCOUNT_ID.
# CLOUDFLARE_ACCOUNT_ID=replace_me
D1_DATABASE_ID=replace_me
CLOUDFLARE_API_TOKEN=replace_me

# Cloudflare Vectorize index for related-reel search (384 dims, cosine).
# The API token also needs Vectorize Edit permission.
# Leave unset to use the local vector index (vectors.sqlite3, query with --related).
VECTORIZE_INDEX=replace_me

# Leave the R2 and D1 values as replace_me (or unset) to run fully locally.
# Or set LOCAL_ONLY=true (same as --local) to ignore all Cloudflare settings:
# progress in vital_progress.sqlite3, images + reel.json in infographics/,
# vectors in vectors.sqlite3. No R2, D1, Vectorize or Worker needed.
# LOCAL_ONLY=true

# Wikipedia etiquette: use a real, contactable User-Agent.
WIKIPEDIA_USER_AGENT=WikipediaReelsBot/1.0 (your-email@example.com)

# Local model; downloaded once and then cached by sentence-transformers.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2