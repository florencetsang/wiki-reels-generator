# Google / Gemini
GEMINI_API_KEY=replace_me
# "gemini-2.5-flash-image" is Nano Banana-compatible.
# Change this if your Gemini account exposes a different image model.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Cloudflare R2 S3 credentials
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=wikipedia-reels

# Optional: only needed when using a jurisdiction-specific R2 endpoint.
# R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Wikipedia etiquette: use a real, contactable User-Agent.
WIKIPEDIA_USER_AGENT=WikipediaReelsBot/1.0 (your-email@example.com)

# Local model; downloaded once and then cached by sentence-transformers.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2